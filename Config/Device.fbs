namespace nos.sys.device;

enum DeviceFlags : uint(bit_flags) {
	PCI = 0,
	GRAPHICS = 1,
	VIDEO_IO = 2,
}

table DeviceProperty{
    name: string (required);
    value: string;
}

table DeviceInfo {
    vendor_name: string;
    model_name: string;
    topological_id: uint64;
    serial_number: string;
    flags: DeviceFlags;
    properties: [DeviceProperty];
}

struct RuntimeDeviceId {
    id: uint64;
}
